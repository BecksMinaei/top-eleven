{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "top-eleven",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c75ad2d3-cecd-4755-b6a0-38228da9660d","database_name": "top-eleven" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1e76673023194b50b0fd73bfeb034a51" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
